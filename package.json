{
  "name": "magpi-acp",
  "version": "0.1.0",
  "description": "Pi ACP runtime adapter for Mischief",
  "keywords": [
    "acp",
    "adapter",
    "agent-client-protocol",
    "mischief",
    "pi-coding-agent"
  ],
  "homepage": "https://github.com/digital-overground/magpi-acp#readme",
  "bugs": {
    "url": "https://github.com/digital-overground/magpi-acp/issues"
  },
  "license": "MIT",
  "author": "Kyle Humphrey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-overground/magpi-acp.git"
  },
  "bin": {
    "magpi-acp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke-acp.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "ultracite": "^7.12.0"
  },
  "engines": {
    "node": ">=22"
  }
}
